<svg width="512" height="512" viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="portalBg" x1="0" y1="0" x2="512" y2="512" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="50%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#020617" />
    </linearGradient>
    <linearGradient id="goldRing" x1="0" y1="0" x2="512" y2="512" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="50%" stop-color="#eab308" />
      <stop offset="100%" stop-color="#ca8a04" />
    </linearGradient>
    <filter id="portalGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="14" flood-color="#000000" flood-opacity="0.45" />
    </filter>
  </defs>

  <!-- Base Rounded Background -->
  <rect x="24" y="24" width="464" height="464" rx="104" fill="url(#portalBg)" filter="url(#portalGlow)" />
  <rect x="36" y="36" width="440" height="440" rx="92" stroke="url(#goldRing)" stroke-width="6" opacity="0.9" fill="none" />

  <!-- CIT Maroon Inner Medallion -->
  <circle cx="256" cy="240" r="150" fill="#7A0000" stroke="#FFE500" stroke-width="4" filter="url(#portalGlow)" />

  <!-- Atomic Orbits in Maroon Medallion -->
  <g stroke="#ffffff" stroke-width="2.5" fill="none" opacity="0.85">
    <ellipse cx="256" cy="240" rx="90" ry="32" transform="rotate(0 256 240)" />
    <ellipse cx="256" cy="240" rx="90" ry="32" transform="rotate(60 256 240)" />
    <ellipse cx="256" cy="240" rx="90" ry="32" transform="rotate(120 256 240)" />
  </g>

  <!-- Central Chisel & 1956 Foundation Emblem -->
  <rect x="248" y="190" width="16" height="54" rx="3" fill="#FFE500" />
  <text x="256" y="222" fill="#7A0000" font-family="-apple-system, sans-serif" font-size="12" font-weight="900" text-anchor="middle">1956</text>
  <circle cx="256" cy="180" r="10" fill="#FFE500" />

  <!-- Mathematics Sigma & Integral Symbols -->
  <text x="175" y="255" fill="#facc15" font-family="Georgia, serif" font-size="34" font-weight="bold" opacity="0.95">∑</text>
  <text x="315" y="255" fill="#facc15" font-family="Georgia, serif" font-size="36" font-style="italic" opacity="0.95">∫</text>

  <!-- Institutional Portal Banner -->
  <rect x="106" y="420" width="300" height="44" rx="22" fill="url(#goldRing)" filter="url(#portalGlow)" />
  <text x="256" y="448" fill="#0f172a" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="17" font-weight="900" text-anchor="middle" letter-spacing="2">CIT ASSESSMENT</text>
</svg>
